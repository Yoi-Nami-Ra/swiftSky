<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>swiftSky</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>MinimumOSVersion</key>
	<string>26.0</string>

	<!-- FR-006c: no multi-window on iPadOS. Left at its default, iPadOS would offer to open a second
	     window, which the single Simulation State / single renderer design does not support. -->
	<key>UIApplicationSupportsMultipleScenes</key>
	<false/>

	<!-- FR-006b: landscape only, both orientations. Portrait is explicitly out of scope; the surface
	     must nonetheless fill any size it is given, including portrait-shaped iPad multitasking sizes. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- FR-004a: the launch appearance must be black and empty. Left at its default this shows a light
	     background, which is precisely the flash FR-004 forbids. No image, no logo, no text. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UIStatusBarHidden</key>
	<true/>

	<!-- NOTE: UIRequiresFullScreen is deliberately absent. It was here set to <false/>, which is
	     already the default, and it is deprecated as of iOS 26.0 and ignored in a future release — so it
	     bought nothing and cost a deprecation warning. Multitasking sizes are handled in code instead
	     (T037): the surface fills whatever dimensions it is given. Do not re-add it. -->
</dict>
</plist>
